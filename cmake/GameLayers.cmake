# Engine không biết game. Phần game nằm ở src/client, src/server, src/shared.
set(game_source_roots
    "${GAME_SOURCE_DIR}/engine"
    "${GAME_SOURCE_DIR}/src/client"
    "${GAME_SOURCE_DIR}/src/server"
    "${GAME_SOURCE_DIR}/src/shared")
set(include_re "^[ \t]*#[ \t]*include[ \t]*\"[a-z0-9_]+/")

# Khám phá module: thư mục có nguồn trực tiếp là module; thư mục con có nguồn trực tiếp là module
# con "cha/con". detail/ không là module (header nội bộ của cha) nên cha quét trọn cây của mình.
# src/client xếp module vào sáu nhóm (app, figure, place, face, book, pack). Nhóm không phải module.
set(game_client_groups app figure place face book pack)
# Thư mục chỉ chứa dữ liệu, không có mã: script Lua gốc của client 2026 (src/client/script, 3 173 tệp .lua).
set(game_data_only_dirs script)
set(modules "")
foreach(tree IN LISTS game_source_roots)
    file(GLOB game_roots LIST_DIRECTORIES true RELATIVE "${tree}" "${tree}/*")
    foreach(root IN LISTS game_roots)
        if(NOT IS_DIRECTORY "${tree}/${root}" OR root IN_LIST game_data_only_dirs)
            continue()
        endif()
        if(root IN_LIST game_client_groups)
            file(GLOB game_grouped LIST_DIRECTORIES true RELATIVE "${tree}/${root}" "${tree}/${root}/*")
            foreach(grouped IN LISTS game_grouped)
                if(NOT IS_DIRECTORY "${tree}/${root}/${grouped}")
                    continue()
                endif()
                list(APPEND modules "${grouped}")
                file(GLOB game_nested LIST_DIRECTORIES true RELATIVE "${tree}/${root}/${grouped}"
                    "${tree}/${root}/${grouped}/*")
                foreach(nested IN LISTS game_nested)
                    if(NOT IS_DIRECTORY "${tree}/${root}/${grouped}/${nested}" OR nested STREQUAL "detail")
                        continue()
                    endif()
                    file(GLOB nested_sources "${tree}/${root}/${grouped}/${nested}/*.cpp")
                    if(nested_sources)
                        list(APPEND modules "${grouped}/${nested}")
                    endif()
                endforeach()
            endforeach()
            continue()
        endif()
        list(APPEND modules "${root}")
        file(GLOB game_subs LIST_DIRECTORIES true RELATIVE "${tree}/${root}" "${tree}/${root}/*")
        foreach(sub IN LISTS game_subs)
            if(NOT IS_DIRECTORY "${tree}/${root}/${sub}")
                continue()
            endif()
            if(sub STREQUAL "detail" OR sub STREQUAL "vulkan" OR sub STREQUAL "d3d12" OR sub STREQUAL
                "d3d11" OR sub STREQUAL "gles")
                # detail là header nội bộ; vulkan/d3d12/d3d11/gles là backend của gpu, quét chung gpu.
                continue()
            endif()
            file(GLOB sub_sources "${tree}/${root}/${sub}/*.cpp")
            if(sub_sources)
                list(APPEND modules "${root}/${sub}")
            endif()
        endforeach()
    endforeach()
endforeach()

# In cạnh sai; SEND_ERROR → mã thoát 1.
function(game_layer_violation module source text)
    file(RELATIVE_PATH where "${GAME_SOURCE_DIR}" "${source}")
    message(SEND_ERROR "tầng: ${module} → ${text} (${where})")
endfunction()

# Kiểm một dòng #include của tệp thuộc module. Include "client/stage/stage.hpp" là dùng module
# client/stage (tên dài thắng), "client/options.hpp" là dùng client.
function(game_check_include module source line)
    set(used "")
    set(path "")
    string(REGEX MATCH "\"([a-z0-9_]+)/([a-z0-9_]+)/([^\"]*)\"" three "${line}")
    if(CMAKE_MATCH_0 AND DEFINED game_layer_${CMAKE_MATCH_1}/${CMAKE_MATCH_2})
        set(used "${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
        set(path "${CMAKE_MATCH_3}")
    else()
        string(REGEX MATCH "\"([a-z0-9_]+)/([^\"]*)\"" two "${line}")
        set(used "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
    endif()
    if(NOT used IN_LIST game_layer_${module})
        game_layer_violation(${module} "${source}" "${used}")
    elseif(NOT used STREQUAL module AND path MATCHES "^detail/")
        game_layer_violation(${module} "${source}" "${used}/detail")
    endif()
endfunction()

# Quét .hpp/.cpp của module: nguồn trực tiếp, header nội bộ detail/, và các thư mục con KHÔNG
# phải module con (backend vulkan/d3d của gpu); module con có bảng riêng nên cha không quét lại.
function(game_module_home module out_home)
    foreach(tree IN LISTS game_source_roots)
        if(IS_DIRECTORY "${tree}/${module}")
            set(${out_home} "${tree}/${module}" PARENT_SCOPE)
            return()
        endif()
        foreach(group IN LISTS game_client_groups)
            if(IS_DIRECTORY "${tree}/${group}/${module}")
                set(${out_home} "${tree}/${group}/${module}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endforeach()
    set(${out_home} "" PARENT_SCOPE)
endfunction()

function(game_check_module module)
    game_module_home(${module} home)
    if(home STREQUAL "")
        message(SEND_ERROR "tầng: không thấy thư mục của ${module}")
        return()
    endif()
    file(GLOB sources "${home}/*.hpp" "${home}/*.cpp")
    file(GLOB_RECURSE deep "${home}/detail/*.hpp" "${home}/detail/*.cpp")
    list(APPEND sources ${deep})
    file(GLOB subs LIST_DIRECTORIES true RELATIVE "${home}" "${home}/*")
    foreach(sub IN LISTS subs)
        if(NOT IS_DIRECTORY "${home}/${sub}")
            continue()
        endif()
        if("${module}/${sub}" IN_LIST modules)
            continue()
        endif()
        file(GLOB_RECURSE sub_sources "${home}/${sub}/*.hpp" "${home}/${sub}/*.cpp")
        list(APPEND sources ${sub_sources})
    endforeach()
    foreach(source IN LISTS sources)
        file(STRINGS "${source}" lines REGEX "${include_re}")
        foreach(line IN LISTS lines)
            game_check_include(${module} "${source}" "${line}")
        endforeach()
    endforeach()
endfunction()

foreach(module IN LISTS modules)
    if(NOT DEFINED game_layer_${module})
        message(SEND_ERROR "tầng: module ${module} chưa có trong bảng")
        continue()
    endif()
    separate_arguments(game_layer_${module})
    game_check_module(${module})
endforeach()
