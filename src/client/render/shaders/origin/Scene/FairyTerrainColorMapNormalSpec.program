//////////////////////////////////////////////////////////////////
vertex_program Terrain/OneLayerColormapNormalSpec_vs hlsl
{
	source FairyTerrainColorMap.hlsl
	entry_point terrain_vs
	target vs_3_0
	column_major_matrices false
	preprocessor_defines HAS_TWO_LAYER=0;HAS_LIGHTMAP=0;HAS_NORMAILSPEC=1

	default_params
	{
		param_named_auto world_matrix world_matrix
		param_named_auto viewproj_matrix viewproj_matrix
		param_named_auto view_matrix	view_matrix
		param_named_auto camera_position camera_position
		
		param_named_auto light_count light_count
		param_named_auto light_position_array[0] light_position_array 8
		param_named_auto light_attenuation_array[0]	light_attenuation_array 8
		param_named_auto light_diffuse_colour_array[0] light_diffuse_colour_array 8
		
		param_named_auto derived_scene_colour derived_scene_colour
		param_named_auto surface_specular_colour surface_specular_colour
		param_named_auto surface_shininess surface_shininess
		param_named_auto light_specular_colour0	light_specular_colour	0
		
		param_named_auto isystem_userdata isystem_userdata
	}
}

