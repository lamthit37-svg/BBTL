# Dự án C++23 theo bộ quy cách cpp23: mọi thứ build sinh ra nằm ngoài cây nguồn
# (build/<preset>/), nên chỉ bỏ thư mục build, cấu hình cá nhân và rác hệ điều hành.
# Không bỏ *.obj, *.lib theo đuôi: .obj còn là mô hình 3D, thư viện bên thứ ba có thể
# cần commit. Tài nguyên nhị phân lớn đi qua Git LFS (.gitattributes).

# Build
/build/
/out/
/Testing/
/cmake-build-*/
/compile_commands.json
CMakeUserPresets.json

# Bản thử và bản chính thức. Mỗi bản tự chứa assets, không trỏ vào assets/ của nguồn.
# dev/server giữ config, bảng, cảnh, SQL trong git. Phần sinh lúc chạy và cả release thì không.
/dev/client/
/dev/web/
/dev/tools/
/dev/admin/
/dev/load/
/dev/server/bin/
/dev/server/pgsql/
/dev/server/data/
/dev/server/log/
/dev/server/tables/shared/
/dev/server/tables/variants/
/dev/server/scenes/**/*.nav
/dev/server/scenes/**/*.bin
/release/

# vcpkg
/vcpkg_installed/

# clangd
/.cache/

# VS
/.vs/
*.user
*.suo

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Rider
/.idea/

# Python
__pycache__/

# Blender
*.blend[0-9]
*.blend[0-9][0-9]

# AI cá nhân
CLAUDE.local.md
AGENTS.override.md
.claude/settings.local.json

# Worktree của các phiên agent chạy song song (mỗi worktree có build/ riêng bên trong)
/.worktrees/
/.claude/worktrees/

# Bí mật
*.local.toml
/.env

# Rác OS
Thumbs.db
*.dmp
desktop.ini
.DS_Store
$RECYCLE.BIN/
~$*
*.tmp
*.swp
*~
